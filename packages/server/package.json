{
  "name": "@raidenyn/server",
  "version": "0.1.0",
  "description": "Composition root: wires line-mcp and bank-mcp tools onto the shared mcp-runtime HTTP server.",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "docs"
  ],
  "type": "commonjs",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@raidenyn/bank-mcp": "workspace:^",
    "@raidenyn/line-client": "workspace:^",
    "@raidenyn/line-client-sqlite": "workspace:^",
    "@raidenyn/line-mcp": "workspace:^",
    "@raidenyn/mcp-runtime": "workspace:^",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "better-sqlite3": "^12.11.1"
  }
}
