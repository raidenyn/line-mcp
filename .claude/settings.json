{
  "enabledPlugins": {
    "mcp-server-dev@claude-plugins-official": true
  },
  "permissions": {
    "allow": [
      "Bash(pnpm run lint*)",
      "Bash(pnpm run build*)",
      "Bash(pnpm run test:unit*)",
      "Bash(pnpm run test:smoke*)",
      "Bash(pnpm run verify*)",
      "Bash(pnpm exec vitest run packages*)",
      "Bash(pnpm exec vitest run tests/architecture*)",
      "Bash(pnpm exec vitest run tests/release*)",
      "Bash(pnpm exec vitest run tests/smoke*)",
      "Bash(pnpm exec vitest run tests/artifacts*)",
      "Bash(pnpm exec vitest run tests/docker*)",
      "Bash(pnpm exec eslint *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(openspec list*)",
      "Bash(openspec validate*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/lint-on-edit.mjs\"",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-context.mjs\"",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
