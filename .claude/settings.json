{
  "enabledPlugins": {
    "mcp-server-dev@claude-plugins-official": true
  },
  "permissions": {
    "allow": [
      "Bash(pnpm run lint*)",
      "Bash(pnpm run build*)",
      "Bash(pnpm run test:unit*)",
      "Bash(pnpm run test:smoke*)",
      "Bash(pnpm run verify*)",
      "Bash(pnpm exec vitest run packages*)",
      "Bash(pnpm exec vitest run tests/architecture*)",
      "Bash(pnpm exec vitest run tests/release*)",
      "Bash(pnpm exec vitest run tests/smoke*)",
      "Bash(pnpm exec vitest run tests/artifacts*)",
      "Bash(pnpm exec vitest run tests/docker*)",
      "Bash(pnpm exec eslint *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(openspec list*)",
      "Bash(openspec validate*)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(gh pr create*)",
      "Bash(gh pr merge*)",
      "Bash(docker push*)",
      "Bash(pnpm run test:e2e*)",
      "Bash(pnpm exec vitest run *e2e*)",
      "Bash(npm run test:e2e*)",
      "Bash(npx vitest run *e2e*)"
    ],
    "deny": [
      "Read(/.line-auth.json)",
      "Read(/.line-mcp-tokens.json)",
      "Read(/data/**)",
      "Read(/.env*)",
      "Read(/.line-mcp-secret)",
      "Read(/auth/**)",
      "Read(/line-qr.png)",
      "Edit(/packages/line-client/assets/ltsm/**)",
      "Bash(npm publish*)",
      "Bash(pnpm publish*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push *+*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/lint-on-edit.mjs\"",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-context.mjs\"",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
