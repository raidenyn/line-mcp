{
  "enabledPlugins": {
    "mcp-server-dev@claude-plugins-official": true
  },
  "permissions": {
    "allow": [
      "Bash(npm run lint*)",
      "Bash(npm run build*)",
      "Bash(npm run test:unit*)",
      "Bash(npm run test:smoke*)",
      "Bash(npm run verify*)",
      "Bash(npx vitest run *)",
      "Bash(npx eslint *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(openspec list*)",
      "Bash(openspec validate*)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(gh pr create*)",
      "Bash(gh pr merge*)",
      "Bash(docker push*)",
      "Bash(npm run test:e2e*)"
    ],
    "deny": [
      "Read(./.line-auth.json)",
      "Read(./.line-mcp-tokens.json)",
      "Read(./data/**)",
      "Read(./.env*)",
      "Edit(./packages/line-client/assets/ltsm/**)",
      "Write(./packages/line-client/assets/ltsm/**)",
      "Bash(npm publish*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)"
    ]
  }
}
